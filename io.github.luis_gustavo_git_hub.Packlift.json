{
  "app-id": "io.github.luis_gustavo_git_hub.Packlift",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "packlift",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--share=network",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--filesystem=home",
    "--filesystem=xdg-data/applications:create",
    "--filesystem=xdg-data/icons:create"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/lib/cmake",
    "/share/man",
    "/share/gtk-doc",
    "/share/bash-completion",
    "*.a",
    "*.la"
  ],
  "modules": [
    {
      "name": "libarchive",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DENABLE_TEST=OFF",
        "-DENABLE_CPIO=OFF",
        "-DENABLE_CAT=OFF",
        "-DENABLE_UNZIP=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://www.libarchive.org/downloads/libarchive-3.8.2.tar.xz",
          "sha256": "db0dee91561cbd957689036a3a71281efefd131d35d1d98ebbc32720e4da58e2"
        }
      ]
    },
    {
      "name": "zstd-cli",
      "buildsystem": "simple",
      "build-commands": [
        "make -C programs zstd",
        "install -Dm755 programs/zstd /app/bin/zstd"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://codeload.github.com/facebook/zstd/tar.gz/refs/tags/v1.5.7",
          "archive-type": "tar-gzip",
          "sha256": "37d7284556b20954e56e1ca85b80226768902e2edabd3b649e9e72c0c9012ee3"
        }
      ]
    },
    {
      "name": "appimageupdate-x86_64",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 appimageupdate-x86_64-linux /app/bin/appimageupdate"
      ],
      "only-arches": [
        "x86_64"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://github.com/pkgforge-dev/AppImageUpdate/releases/download/0.4.1/appimageupdate-x86_64-linux",
          "sha256": "6bdaad9a3bcb0dd0cee345b89b24efb94c09c05e5c30ca88dadc1556344c5b18",
          "dest-filename": "appimageupdate-x86_64-linux"
        }
      ]
    },
    {
      "name": "appimageupdate-aarch64",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 appimageupdate-aarch64-linux /app/bin/appimageupdate"
      ],
      "only-arches": [
        "aarch64"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://github.com/pkgforge-dev/AppImageUpdate/releases/download/0.4.1/appimageupdate-aarch64-linux",
          "sha256": "b26a110337002cb19afc84824912821548e3c621228321a81e968cce7682b5d0",
          "dest-filename": "appimageupdate-aarch64-linux"
        }
      ]
    },
    {
      "name": "appimageupdate-license",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm644 AppImageUpdate-LICENSE /app/share/licenses/io.github.luis_gustavo_git_hub.Packlift/AppImageUpdate-LICENSE"
      ],
      "sources": [
        {
          "type": "file",
          "path": "data/AppImageUpdate-LICENSE"
        }
      ]
    },
    {
      "name": "libgsf",
      "buildsystem": "autotools",
      "config-opts": [
        "--enable-introspection=no",
        "--disable-gtk-doc"
      ],
      "cleanup": [
        "/bin"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libgsf/1.14/libgsf-1.14.53.tar.xz",
          "sha256": "0eb59a86e0c50f97ac9cfe4d8cc1969f623f2ae8c5296f2414571ff0a9e8bcba"
        }
      ]
    },
    {
      "name": "gcab",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Ddocs=false",
        "-Dtests=false",
        "-Dintrospection=false",
        "-Dvapi=false"
      ],
      "cleanup": [
        "/bin"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/gcab/1.6/gcab-1.6.tar.xz",
          "sha256": "2f0c9615577c4126909e251f9de0626c3ee7a152376c15b5544df10fc87e560b"
        }
      ]
    },
    {
      "name": "msitools",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dintrospection=false",
        "-Dvalidate-wxi=false"
      ],
      "cleanup": [
        "/bin/msidiff",
        "/bin/msidump",
        "/bin/msibuild",
        "/share/msitools"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/msitools/0.106/msitools-0.106.tar.xz",
          "sha256": "1ed34279cf8080f14f1b8f10e649474125492a089912e7ca70e59dfa2e5a659b"
        }
      ]
    },
    {
      "name": "unsquashfs",
      "buildsystem": "simple",
      "build-commands": [
        "make -C squashfs-tools unsquashfs XZ_SUPPORT=1 ZSTD_SUPPORT=1 LZ4_SUPPORT=1",
        "install -Dm755 squashfs-tools/unsquashfs /app/bin/unsquashfs"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://codeload.github.com/plougher/squashfs-tools/tar.gz/refs/tags/4.6.1",
          "archive-type": "tar-gzip",
          "sha256": "9c4974e07c61547dae14af4ed1f358b7d04618ae194e54d6be72ee126f0d2f53"
        }
      ]
    },
    {
      "name": "umu-launcher",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 umu-run /app/bin/umu-run"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/Open-Wine-Components/umu-launcher/releases/download/1.4.4/umu-launcher-1.4.4-zipapp.tar",
          "sha256": "eb590691841f7fad3fc3ad8fd5db4ccb87849fe7948e62b28ece7a4ee48cc851"
        }
      ]
    },
    {
      "name": "packlift",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/packlift/cargo-home"
        }
      },
      "build-commands": [
        "mkdir -p \"$CARGO_HOME\" && install -m 644 cargo-config.toml \"$CARGO_HOME/config.toml\"",
        "cargo build --offline --locked --release --features gui",
        "install -Dm755 target/release/packlift /app/bin/packlift",
        "ln -s packlift /app/bin/flatapk",
        "install -Dm644 data/io.github.luis_gustavo_git_hub.Packlift.desktop /app/share/applications/io.github.luis_gustavo_git_hub.Packlift.desktop",
        "install -Dm644 data/io.github.luis_gustavo_git_hub.Packlift.service /app/share/dbus-1/services/io.github.luis_gustavo_git_hub.Packlift.service",
        "install -Dm644 data/io.github.luis_gustavo_git_hub.Packlift.search-provider.ini /app/share/gnome-shell/search-providers/io.github.luis_gustavo_git_hub.Packlift.search-provider.ini",
        "install -Dm644 data/io.github.luis_gustavo_git_hub.Packlift.metainfo.xml /app/share/metainfo/io.github.luis_gustavo_git_hub.Packlift.metainfo.xml",
        "install -Dm644 data/io.github.luis_gustavo_git_hub.Packlift.xml /app/share/mime/packages/io.github.luis_gustavo_git_hub.Packlift.xml",
        "install -Dm644 data/io.github.luis_gustavo_git_hub.Packlift.png /app/share/icons/hicolor/256x256/apps/io.github.luis_gustavo_git_hub.Packlift.png",
        "install -Dm644 data/flatpak-logo.svg /app/share/icons/hicolor/scalable/apps/packlift-flatpak.svg"
      ],
      "sources": [
        {
          "type": "file",
          "path": "Cargo.toml"
        },
        {
          "type": "file",
          "path": "Cargo.lock"
        },
        {
          "type": "dir",
          "path": "src",
          "dest": "src"
        },
        {
          "type": "file",
          "path": "cargo-config.toml"
        },
        {
          "type": "dir",
          "path": "data",
          "dest": "data"
        },
        "cargo-sources.json"
      ]
    }
  ],
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/packlift/cargo-home"
    }
  }
}
