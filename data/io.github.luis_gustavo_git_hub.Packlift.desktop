[Desktop Entry]
Type=Application
Name=Packlift
Comment=Install Linux and Windows packages
Comment[pt_BR]=Instale pacotes de Linux e Windows
Comment[pt]=Instale pacotes de Linux e Windows
Comment[es]=Instala paquetes de Linux y Windows
Comment[ru]=Устанавливайте пакеты Linux и Windows
Comment[zh]=安装 Linux 和 Windows 软件包
Comment[zh_CN]=安装 Linux 和 Windows 软件包
Exec=flatapk %F
Icon=io.github.luis_gustavo_git_hub.Packlift
Terminal=false
Categories=Settings;PackageManager;GTK;
Keywords=Packages;Toolbox;Wine;Installer;
Keywords[pt_BR]=Pacotes;Toolbox;Wine;Instalador;
StartupNotify=true
MimeType=application/vnd.debian.binary-package;application/x-deb;application/x-rpm;application/vnd.appimage;application/x-iso9660-appimage;application/x-tar;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-ms-dos-executable;application/x-msdownload;application/vnd.microsoft.portable-executable;application/x-msi;application/x-flatapk-windows-setup;application/x-flatapk-arch-package;application/vnd.flatpak;application/vnd.flatpak.ref;
